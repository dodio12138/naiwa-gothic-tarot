{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposition",
  "description": "语义框架：一张牌可讨论的核心命题（不是事实陈述）",
  "type": "object",
  "required": [
    "proposition_id",
    "card_refs",
    "text",
    "framework",
    "symbol_refs",
    "applicable_conditions",
    "counterexamples",
    "source_kind",
    "review_status",
    "version"
  ],
  "properties": {
    "proposition_id": {
      "type": "string",
      "pattern": "^prop\\.major_\\d{2}\\.\\d{2}$"
    },
    "card_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^major_\\d{2}$|^(wands|cups|swords|pentacles)_\\d{2}$"
      },
      "minItems": 1
    },
    "text": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "framework": {
      "enum": [
        "traditional_rws",
        "hermetic",
        "jungian_extension",
        "existential_extension",
        "dialectical_extension",
        "daoist_extension",
        "stoic_extension",
        "naiwa_original"
      ]
    },
    "symbol_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "applicable_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_kind": {
      "enum": [
        "traditional",
        "original_interpretation"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed",
        "quarantined"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
