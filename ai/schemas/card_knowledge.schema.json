{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardKnowledge",
  "description": "知识库：一张牌在某个传统下的知识侧表（由 build_kb.mjs 生成）",
  "type": "object",
  "required": [
    "card_id",
    "tradition_card_ref",
    "tradition_id",
    "name",
    "traditional",
    "artwork_ref",
    "visual_symbol_refs",
    "review_status"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^major_\\d{2}$|^(wands|cups|swords|pentacles)_\\d{2}$"
    },
    "tradition_card_ref": {
      "type": "string",
      "pattern": "^rws\\.(major|minor)\\..+$"
    },
    "tradition_id": {
      "const": "rws"
    },
    "name": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "traditional": {
      "type": "object",
      "required": [
        "keywords",
        "upright",
        "reversed"
      ],
      "properties": {
        "keywords": {
          "type": "object"
        },
        "upright": {
          "type": "object",
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "reversed": {
          "type": "object",
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "correspondence": {
          "type": "object",
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "archetype": {
          "type": "object",
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artwork_ref": {
      "type": "string",
      "pattern": "^naiwa\\.classic\\."
    },
    "visual_symbol_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "rws_absent": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed",
        "quarantined"
      ]
    },
    "naiwa_symbol_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "传统没有、用户决定保留的奶蛙版特有象征"
    },
    "style_removed_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "哥特与风格化夜晚元素：不得被引用"
    },
    "imagery_compare": {
      "type": "array",
      "description": "与韦特传统意象的逐项对照",
      "items": {
        "type": "object",
        "required": [
          "rws",
          "zh",
          "status"
        ],
        "properties": {
          "rws": {
            "type": "string"
          },
          "zh": {
            "type": "string"
          },
          "status": {
            "enum": [
              "present",
              "altered",
              "absent"
            ]
          },
          "symbol_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "waite_1911": {
      "type": "object",
      "description": "韦特 1911 原文的占卜义（英文原文）",
      "properties": {
        "upright": {
          "type": "string"
        },
        "reversed": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
